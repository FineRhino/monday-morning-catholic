---
import Base from '../layouts/Base.astro';
import DailyRhythm from '../components/DailyRhythm.svelte';
import PrayerList from '../components/PrayerList.svelte';
import PrayerBook from '../components/PrayerBook.svelte';
import SavedPassages from '../components/SavedPassages.svelte';
import Journal from '../components/Journal.svelte';
import TodayReadings from '../components/TodayReadings.astro';
---
<Base>
  <section class="today gut">
    <div class="in">
      <div class="head">
        <div class="label">today</div>
        <h1>Faith for the rest of the week.</h1>
      </div>
      <div class="greet">
        <TodayReadings />
      </div>
      <DailyRhythm client:only="svelte" />
    </div>
  </section>

  <section class="dash gut" aria-labelledby="workbook">
    <div class="in">
      <div class="wb-head">
        <div class="label">workbook</div>
        <h2 id="workbook">My spiritual workbook</h2>
        <p class="muted">Your notes, the people you're praying for, and the prayers and passages you've saved. Everything stays on this device, or in your account if you sign in.</p>
      </div>
      <div class="journal"><Journal client:only="svelte" /></div>
      <PrayerList client:only="svelte" />
      <PrayerBook client:only="svelte" />
      <SavedPassages client:only="svelte" />
    </div>
  </section>

</Base>

<style>
  .today { padding-block: 36px 16px; }
  .today .in { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr); gap: 18px 28px; align-items: start; }
  /* The heading spans both columns so the readings and the rhythm panel start at the same height. */
  .head { grid-column: 1 / -1; display: grid; gap: 14px; }
  .greet { display: grid; gap: 14px; justify-items: start; }
  h1 { font-size: clamp(34px, 5.4vw, 54px); line-height: 1.05; }
  h2 { font-size: clamp(26px, 3.6vw, 34px); }
  .dash { padding-block: 24px 56px; }
  .wb-head { grid-column: 1 / -1; display: grid; gap: 6px; }
  .wb-head p { margin: 0; max-width: 66ch; }
  .journal { grid-column: 1 / -1; }
  .dash .in { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; align-items: start; }
  @media (max-width: 980px) { .dash .in { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 860px) { .today .in { grid-template-columns: minmax(0, 1fr); } }
  @media (max-width: 640px) { .dash .in { grid-template-columns: minmax(0, 1fr); } }
</style>
