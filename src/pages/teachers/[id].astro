---
import { getCollection, type CollectionEntry } from 'astro:content';
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import { ERAS } from '../../data/eras';
import { kindsOf, kindLabels } from '../../data/teachers';

export async function getStaticPaths() {
  // Same order as the Teachers page: by year of death.
  const all = (await getCollection('doctors')).sort((a, b) => a.data.died - b.data.died || a.data.name.localeCompare(b.data.name));
  const link = (d?: CollectionEntry<'doctors'>) => d && { id: d.id, name: d.data.name };
  return all.map((d, i) => ({
    params: { id: d.id },
    props: { doctor: d, prev: link(all[i - 1]), next: link(all[i + 1]), position: i + 1, total: all.length },
  }));
}
interface Neighbor { id: string; name: string; }
const { doctor, prev, next, position, total } = Astro.props as {
  doctor: CollectionEntry<'doctors'>; prev?: Neighbor; next?: Neighbor; position: number; total: number;
};
const d = doctor.data;
const era = ERAS.find((e) => e.id === d.era)!;
const kinds = kindsOf(d);
const related = await getCollection('articles', (a) => (import.meta.env.DEV || !a.data.draft) && a.data.doctors.some((r) => r.id === doctor.id));
---
<Base title={d.name} description={d.summary}>
  <div class="gut"><div class="in page" style={`--c: var(--${d.era})`}>
    <nav class="pager" aria-label="Doctors, saints and theologians">
      {prev ? <a class="prev" href={`/teachers/${prev.id}/`} rel="prev" data-key="ArrowLeft"><span aria-hidden="true">←</span><span class="nm">{prev.name}</span></a> : <span></span>}
      <span class="pos">{position} of {total}</span>
      {next ? <a class="next" href={`/teachers/${next.id}/`} rel="next" data-key="ArrowRight"><span class="nm">{next.name}</span><span aria-hidden="true">→</span></a> : <span></span>}
    </nav>
    <a class="label" href="/teachers/">doctors, saints and theologians · {era.name.toLowerCase()}</a>
    <h1>{d.name}</h1>
    <p class="meta">{d.role}{d.title && ` · ${d.title}`}</p>
    <p class="kinds">{kindLabels(kinds).map((k) => <span class:list={['kind', k.toLowerCase()]}>{k}</span>)}</p>
    <dl>
      <div><dt>Died</dt><dd>{d.died}</dd></div>
      {d.proclaimed !== undefined && <div><dt>Proclaimed a Doctor</dt><dd>{d.proclaimed}</dd></div>}
      {d.proclaimed !== undefined && <div><dt>Years between</dt><dd>{d.proclaimed - d.died}</dd></div>}
    </dl>
    <p class="prose summary">{d.summary}</p>
    {(d.printable || d.resources.length > 0) && (
      <div class="extras">
        {d.printable && (
          <section class="printable">
            <h2>Printable</h2>
            <a href={d.printable.download}>
              <Picture src={d.printable.image} alt={d.printable.alt} formats={['avif', 'webp']} fallbackFormat="jpg" widths={[400, 700, d.printable.image.width]} sizes="(max-width: 600px) calc(100vw - 32px), 560px" />
            </a>
            <p><a href={d.printable.download} download>Download to print</a> <span class="muted">(JPEG)</span></p>
          </section>
        )}
        {d.resources.length > 0 && (
          <section class="resources panel">
            <h2>Resources</h2>
            <p class="muted">{d.woman ? "Her" : "His"} writings and further reading online.</p>
            <ul>
              {d.resources.map((r) => (
                <li>
                  <a href={r.url} rel="noopener">{r.title}</a>
                  <span class="src">{r.source}</span>
                  {r.note && <span class="note">{r.note}</span>}
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>
    )}
    {related.length > 0 && (
      <section>
        <h2>Articles drawing on {d.name}</h2>
        <ul>{related.map((a) => <li><a href={`/articles/${a.id}/`}>{a.data.title}</a></li>)}</ul>
      </section>
    )}
    <nav class="pager bottom" aria-label="Doctors of the Church">
      {prev ? <a class="prev" href={`/teachers/${prev.id}/`} rel="prev" data-key="ArrowLeft"><span aria-hidden="true">←</span><span class="nm">{prev.name}</span></a> : <span></span>}
      <span class="pos">{position} of {total}</span>
      {next ? <a class="next" href={`/teachers/${next.id}/`} rel="next" data-key="ArrowRight"><span class="nm">{next.name}</span><span aria-hidden="true">→</span></a> : <span></span>}
    </nav>
  </div></div>
</Base>

<script>
  // Left and right arrow keys move to the previous and next Doctor, unless someone is typing.
  document.addEventListener('keydown', (e) => {
    if (e.altKey || e.ctrlKey || e.metaKey || e.shiftKey) return;
    if ((e.target as HTMLElement).closest('input, textarea, select, [contenteditable]')) return;
    const a = document.querySelector<HTMLAnchorElement>(`.pager a[data-key="${e.key}"]`);
    if (a) location.href = a.href;
  });
</script>

<style>
  .page { display: grid; gap: 14px; padding-block: 36px 56px; justify-items: start; }
  .label { text-decoration: none; }
  .pager { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 12px; width: 100%; font-size: 15px; }
  .pager.bottom { margin-top: 24px; padding-top: 14px; border-top: 1px solid var(--rule); }
  .pager a { text-decoration: none; color: var(--muted); padding: 6px 12px; border: 1px solid var(--rule); border-radius: 999px; background: var(--surface); display: flex; gap: 6px; min-width: 0; }
  .pager .nm { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .pager a:hover { color: var(--ink); border-color: var(--gold); }
  .pager .prev { justify-self: start; max-width: 100%; }
  .pager .next { justify-self: end; max-width: 100%; }
  .pager span[aria-hidden] { color: var(--gold); font-weight: 700; }
  .pager .pos { font-size: 13.5px; color: var(--muted); font-variant-numeric: tabular-nums; }
  h1 { font-size: clamp(36px, 6vw, 56px); color: var(--c); }
  .meta { margin: 0; color: var(--muted); }
  .kinds { display: flex; flex-wrap: wrap; gap: 6px; margin: 2px 0 0; }
  .kind { box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; width: 104px; height: 26px; padding: 0; font-family: var(--label); font-size: 13px; font-weight: 700; line-height: 1; letter-spacing: .06em; border-radius: 999px; border: 1px solid var(--rule); color: var(--muted); white-space: nowrap; }
  .kind.doctor { background: var(--gold-soft); border-color: var(--gold); color: var(--gold); }
  .kind.saint { border-color: var(--c); color: var(--c); }
  dl { display: flex; flex-wrap: wrap; gap: 0; margin: 8px 0; border-block: 1px solid var(--rule); }
  dl div { padding: 12px 20px 12px 0; margin-right: 20px; }
  dt { font-size: 14px; color: var(--muted); }
  dd { margin: 0; font-family: var(--display); font-size: 30px; font-variant-numeric: tabular-nums; }
  .summary { font-size: 19px; }
  h2 { font-size: 22px; }
  .extras { display: grid; grid-template-columns: minmax(0, 560px) minmax(240px, 360px); column-gap: 24px; row-gap: 10px; align-items: start; width: 100%; }
  .printable { display: grid; gap: 10px; width: 100%; }
  /* Side by side: the printable's heading, image, and download link sit in the grid's three rows,
     so the Resources box starts level with the top of the image, not the heading. */
  @media (min-width: 861px) {
    .extras:has(.printable) { grid-template-rows: auto auto auto; }
    .printable { grid-column: 1; grid-row: 1 / span 3; grid-template-rows: subgrid; }
    .printable + .resources { grid-column: 2; grid-row: 2 / span 2; }
  }
  @media (max-width: 860px) { .extras { grid-template-columns: minmax(0, 560px); row-gap: 24px; } }
  .printable img { display: block; width: 100%; height: auto; border: 1px solid var(--rule); border-radius: 8px; }
  .printable p { margin: 0; }
  .resources { position: sticky; top: 80px; }
  .resources > p { margin: -6px 0 0; font-size: 15px; }
  .resources ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .resources li { display: grid; gap: 1px; }
  .resources a { font-weight: 700; }
  .resources .src { font-family: var(--label); font-size: 13px; font-weight: 700; letter-spacing: .06em; color: var(--gold); }
  .resources .note { font-size: 14.5px; color: var(--muted); }
</style>
