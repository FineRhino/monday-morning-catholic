---
import { getCollection } from 'astro:content';

// Show the newest day on file. The site is rebuilt each morning right after the readings are added.
const latest = (await getCollection('readings')).map((r) => r.data).sort((a, b) => b.date.localeCompare(a.date))[0];
const day = latest && new Date(`${latest.date}T12:00:00Z`).toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', timeZone: 'UTC' });
---
{latest && (
  <section class="readings" aria-labelledby="readings-title">
    <div class="label">mass readings · {day}</div>
    <h2 id="readings-title">{latest.title}</h2>
    <p class="summary">{latest.summary}</p>
    <ul>
      {latest.readings.map((r) => (
        <li><span>{r.label}</span>{r.citation}{r.alt && <> <i>or</i> {r.alt}</>}</li>
      ))}
    </ul>
    <a href={latest.url}>Read the full readings at USCCB</a>
  </section>
)}

<style>
  .readings { display: grid; gap: 8px; width: 100%; padding: 16px 18px; border: 1px solid var(--rule); border-radius: 8px; background: var(--surface); }
  h2 { font-size: 22px; }
  .summary { margin: 0; font-size: 18px; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; font-size: 15px; }
  li span { display: inline-block; min-width: 9.5em; color: var(--muted); }
  i { color: var(--muted); }
  a { font-size: 15px; color: var(--gold); }
</style>
